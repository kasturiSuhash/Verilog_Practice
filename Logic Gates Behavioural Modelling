module logic_gates(
    input wire x, y,
    output reg a, b, c, d, e, f
);

always @(*) begin
    // OR gate
    if (x == 1 || y == 1) a = 1;
    else a = 0;

    // AND gate 
    if (x == 1 && y == 1) b = 1;
    else b = 0;

    // NAND gate
    if (x == 1 && y == 1) c = 0;
    else c = 1;

    // NOR gate 
    if (x == 0 && y == 0) d = 1;
    else d = 0;

    // XOR gate
    if (x == 1 && y == 1) e = 0;
    else if (x == 0 && y == 0) e = 0;
    else e = 1;

    // XNOR gate
    if (x == 1 && y == 1) f = 1;
    else if (x == 0 && y == 0) f = 1;
    else f = 0;
end

endmodule
